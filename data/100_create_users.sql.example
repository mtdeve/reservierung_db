CREATE USER IF NOT EXISTS 'db_admin'@'localhost'
IDENTIFIED BY 'CHANGE_ME_ADMIN';

CREATE USER IF NOT EXISTS 'reservation_app'@'localhost'
IDENTIFIED BY 'CHANGE_ME_APP';

GRANT 'admin_role' TO 'db_admin'@'localhost';
GRANT 'app_role' TO 'reservation_app'@'localhost';

SET DEFAULT ROLE 'admin_role'
TO 'db_admin'@'localhost';

SET DEFAULT ROLE 'app_role'
TO 'reservation_app'@'localhost';